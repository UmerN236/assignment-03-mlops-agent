# Copy only if .env does not already exist. Empty entries use documented defaults.
# Never commit credentials. The configured provider must use a free model.
LLM_PROVIDER=
LLM_MODEL=
OPENROUTER_MODEL=
GEMINI_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TOOL_TIMEOUT_SECONDS=
LLM_TIMEOUT_SECONDS=
MAX_TOOL_ITERATIONS=
MLFLOW_TRACKING_URI=
AIRFLOW_BASE_URL=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_TOKEN=
AIRFLOW_TRAINING_DAG_ID=
KUBECONFIG=
KUBERNETES_CONTEXT=
KUBERNETES_NAMESPACE=
DVC_REPO_PATH=
# Inference process environment only; the inference app never loads .env itself.
# Docker supplies /app/model. Local default is artifacts/inference.
MODEL_BUNDLE_PATH=
